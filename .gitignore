# Python environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Model weights — never committed
models/*.pt
models/*.pth
models/*.onnx
models/backbones/

# Downloaded datasets — never committed.
# Anchored with a leading slash on purpose: an unanchored `data/` also matched
# src/animal_classifier/taxonomy/data/, which silently dropped the shipped
# taxonomy CSVs from both `git add -A` and the wheel (hatchling honours VCS
# ignore files when selecting files).
/data/

# Catalog / databases
*.sqlite
*.db

# Generated test and run output
tests/**/output/
tests/**/_output/
build/
dist/
*.egg-info/
